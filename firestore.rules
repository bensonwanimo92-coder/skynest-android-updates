rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsExistingRecord() {
      return signedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    function ownsNewRecord() {
      return signedIn()
        && request.resource.data.createdBy == request.auth.uid;
    }

    function isAssignedLandlord() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.landlordId
          == resource.data.landlordId;
    }

    // User profile documents and houses stored beneath each user.
    match /users/{userId} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;

      match /houses/{houseId} {
        allow read, create, update, delete: if signedIn()
          && request.auth.uid == userId;
      }
    }

    // Top-level houses collection used by the current Flutter app.
    match /houses/{houseId} {
      allow create: if ownsNewRecord();
      allow read, delete: if ownsExistingRecord();
      allow update: if ownsExistingRecord() && ownsNewRecord();
    }

    // Caretakers submit proposed houses for their assigned landlord to review.
    // This is a separate queue: an offer does not become a live house automatically.
    match /house_offers/{offerId} {
      allow create: if signedIn()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.landlordId is string
        && request.resource.data.landlordId.size() > 0
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.landlordId
          == request.resource.data.landlordId
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(['submittedBy', 'landlordId', 'status']);

      allow read: if signedIn()
        && (resource.data.submittedBy == request.auth.uid
          || resource.data.landlordId == request.auth.uid);

      allow update: if signedIn()
        && resource.data.landlordId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewNote', 'reviewedBy'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.landlordId == request.auth.uid;
    }

    match /tenants/{recordId} {
      allow create: if ownsNewRecord();
      allow read, delete: if ownsExistingRecord();
      allow update: if ownsExistingRecord() && ownsNewRecord();
    }

    match /payments/{recordId} {
      allow create: if ownsNewRecord();
      allow read, delete: if ownsExistingRecord();
      allow update: if ownsExistingRecord() && ownsNewRecord();
    }

    match /plans/{recordId} {
      allow create: if ownsNewRecord();
      allow read, delete: if ownsExistingRecord();
      allow update: if ownsExistingRecord() && ownsNewRecord();
    }

    match /subscriptions/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }
  }
}