rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function activeUser() { return signedIn() && profile(request.auth.uid).status == 'active'; }
    function myRole() { return profile(request.auth.uid).role; }
    function landlordFor(id) {
      return activeUser() && (
        (myRole() == 'landlord' && request.auth.uid == id) ||
        (myRole() == 'caretaker' && profile(request.auth.uid).landlordId == id)
      );
    }
    function linkedTo(id) {
      return activeUser() && (
        (myRole() == 'landlord' && request.auth.uid == id) ||
        profile(request.auth.uid).landlordId == id
      );
    }
    function validInvitation(code, role, landlordId) {
      let invite = get(/databases/$(database)/documents/invitations/$(code)).data;
      return invite.status == 'open' && invite.role == role &&
        invite.landlordId == landlordId && invite.expiresAt > request.time;
    }

    match /users/{userId} {
      allow get: if signedIn() && (
        request.auth.uid == userId ||
        (resource.data.landlordId != null && landlordFor(resource.data.landlordId))
      );
      allow list: if activeUser() && (
        (myRole() == 'landlord' && resource.data.landlordId == request.auth.uid) ||
        (myRole() == 'caretaker' && resource.data.landlordId == profile(request.auth.uid).landlordId)
      );
      allow create: if signedIn() && request.auth.uid == userId && (
        (request.resource.data.role == 'landlord' && request.resource.data.status == 'active') ||
        (
          request.resource.data.role in ['tenant', 'caretaker'] &&
          request.resource.data.status == 'pending' &&
          request.resource.data.invitationCode is string &&
          validInvitation(request.resource.data.invitationCode, request.resource.data.role, request.resource.data.landlordId)
        )
      );
      allow update: if signedIn() && (
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.landlordId == resource.data.landlordId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone', 'photoUrl', 'updatedAt'])
        ) ||
        // One-time, self-only migration for pre-role accounts with no tenant/caretaker linkage.
        (
          request.auth.uid == userId &&
          !resource.data.keys().hasAny(['role', 'status', 'landlordId', 'invitationCode']) &&
          request.resource.data.role == 'landlord' &&
          request.resource.data.status == 'active' &&
          request.resource.data.legacyAccount == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'legacyAccount', 'updatedAt'])
        ) ||
        // Repair status only for an already identified landlord; never assign a role here.
        (
          request.auth.uid == userId &&
          resource.data.role == 'landlord' &&
          !resource.data.keys().hasAny(['status']) &&
          request.resource.data.role == 'landlord' &&
          request.resource.data.status == 'active' &&
          request.resource.data.legacyAccount == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'legacyAccount', 'updatedAt'])
        ) ||
        (
          resource.data.role == 'tenant' &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['active', 'rejected'] &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.landlordId == resource.data.landlordId &&
          landlordFor(resource.data.landlordId)
        ) ||
        (
          resource.data.role == 'caretaker' &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['active', 'rejected'] &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.landlordId == resource.data.landlordId &&
          myRole() == 'landlord' && request.auth.uid == resource.data.landlordId
        ) ||
        (
          resource.data.role == 'caretaker' &&
          resource.data.status == 'active' &&
          request.resource.data.status == 'suspended' &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.landlordId == resource.data.landlordId &&
          myRole() == 'landlord' && request.auth.uid == resource.data.landlordId
        ) ||
        (
          resource.data.role == 'tenant' &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.landlordId == resource.data.landlordId &&
          landlordFor(resource.data.landlordId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['houseId', 'houseNo'])
        )
      );
      allow delete: if signedIn() && request.auth.uid == userId;

      match /devices/{deviceId} {
        allow read, create, update, delete: if activeUser() && request.auth.uid == userId;
      }

      match /houses/{houseId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
      match /notices/{noticeId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && landlordFor(profile(userId).landlordId) &&
          request.resource.data.landlordId == profile(userId).landlordId;
        allow update, delete: if false;
      }
    }

    match /invitations/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && myRole() == 'landlord' && resource.data.landlordId == request.auth.uid;
      allow create: if activeUser() && myRole() == 'landlord' &&
        request.resource.data.landlordId == request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.role in ['tenant', 'caretaker'] &&
        request.resource.data.status == 'open';
      allow update: if signedIn() && resource.data.status == 'open' &&
        request.resource.data.status == 'used' &&
        request.resource.data.usedBy == request.auth.uid &&
        request.resource.data.landlordId == resource.data.landlordId &&
        request.resource.data.role == resource.data.role &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.invitationCode == code &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.landlordId == resource.data.landlordId;
      allow delete: if activeUser() && myRole() == 'landlord' && resource.data.landlordId == request.auth.uid;
    }

    match /houses/{houseId} {
      allow create: if activeUser() && myRole() == 'landlord' &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.landlordId == request.auth.uid;
      allow read: if activeUser() && (
        resource.data.createdBy == request.auth.uid ||
        (myRole() == 'caretaker' && request.auth.uid in resource.data.caretakerIds) ||
        (myRole() == 'tenant' && resource.data.landlordId == profile(request.auth.uid).landlordId && resource.data.isOccupied == false)
      );
      allow update: if activeUser() && (
        resource.data.createdBy == request.auth.uid ||
        (myRole() == 'caretaker' && request.auth.uid in resource.data.caretakerIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOccupied', 'status', 'assignedTenantId']))
      );
      allow delete: if activeUser() && resource.data.createdBy == request.auth.uid;
    }

    match /tenants/{recordId} {
      allow create: if activeUser() && (
        (myRole() == 'landlord' && request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.landlordId == request.auth.uid) ||
        (myRole() == 'caretaker' && request.resource.data.createdBy == profile(request.auth.uid).landlordId &&
          request.resource.data.landlordId == profile(request.auth.uid).landlordId)
      );
      allow read: if activeUser() && (
        resource.data.createdBy == request.auth.uid ||
        (resource.data.landlordId != null && landlordFor(resource.data.landlordId))
      );
      allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /payments/{recordId} {
      allow create: if activeUser() && myRole() == 'landlord' && request.resource.data.createdBy == request.auth.uid;
      allow read: if activeUser() && resource.data.createdBy == request.auth.uid;
      allow update: if activeUser() && resource.data.createdBy == request.auth.uid;
      allow delete: if activeUser() && resource.data.createdBy == request.auth.uid;
    }

    function validMpesaClaim(code) {
      let submissionPath = /databases/$(database)/documents/paymentSubmissions/$(request.resource.data.submissionId);
      return existsAfter(submissionPath) &&
        getAfter(submissionPath).data.tenantId == request.auth.uid &&
        getAfter(submissionPath).data.landlordId == profile(request.auth.uid).landlordId &&
        getAfter(submissionPath).data.transactionCode == code &&
        getAfter(submissionPath).data.method == 'MPESA';
    }


    match /paymentConfirmations/{id} {
      allow read: if activeUser() && myRole() == 'caretaker' && resource.data.caretakerId == request.auth.uid;
      allow update: if activeUser() && myRole() == 'caretaker' && resource.data.caretakerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedBy', 'confirmedAt']);
      allow create: if activeUser() && myRole() == 'landlord' && request.resource.data.landlordId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['landlordId', 'caretakerId', 'tenantName', 'houseNo', 'paymentId', 'status', 'createdAt']);
      allow delete: if false;
    }

    match /complaints/{id} {
      allow create: if activeUser() && request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.landlordId != null &&
        (myRole() == 'tenant' || myRole() == 'caretaker' || myRole() == 'landlord');
      allow read: if activeUser() && (
        resource.data.createdBy == request.auth.uid ||
        landlordFor(resource.data.landlordId)
      );
      allow update: if activeUser() && landlordFor(resource.data.landlordId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastUpdatedAt', 'lastUpdatedBy', 'response']);
      allow delete: if false;
    }

    match /groups/{groupId} {
      allow create: if activeUser() && request.resource.data.createdBy == request.auth.uid &&
        linkedTo(request.resource.data.landlordId) && request.auth.uid in request.resource.data.memberIds;
      allow read: if linkedTo(resource.data.landlordId);
      allow update: if activeUser() && linkedTo(resource.data.landlordId) && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
          request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
          request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
          request.auth.uid in request.resource.data.memberIds
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
          resource.data.memberIds.hasAll(request.resource.data.memberIds) &&
          resource.data.memberIds.size() == request.resource.data.memberIds.size() + 1 &&
          request.auth.uid in resource.data.memberIds &&
          !(request.auth.uid in request.resource.data.memberIds)
        ) ||
        (
          resource.data.createdBy == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        )
      );
      allow delete: if activeUser() && resource.data.createdBy == request.auth.uid;
      match /members/{memberId} {
        allow read: if activeUser() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if activeUser() && request.auth.uid == memberId &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow update, delete: if activeUser() && request.auth.uid == memberId;
      }
      match /messages/{messageId} {
        allow read: if activeUser() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if activeUser() && request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow update: if false;
        allow delete: if activeUser() &&
          request.auth.uid == resource.data.senderId &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }
    }

    match /houseRequests/{id} {
      allow create: if activeUser() && myRole() == 'tenant' && request.resource.data.tenantId == request.auth.uid &&
        request.resource.data.landlordId == profile(request.auth.uid).landlordId;
      allow read: if activeUser() && (
        resource.data.tenantId == request.auth.uid || landlordFor(resource.data.landlordId)
      );
      allow update: if activeUser() && landlordFor(resource.data.landlordId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy']);
      allow delete: if false;
    }

    match /notices/{id} {
      allow create: if activeUser() && landlordFor(request.resource.data.landlordId) &&
        request.resource.data.createdBy == request.auth.uid;
      allow read: if landlordFor(resource.data.landlordId) || (activeUser() && resource.data.audience == 'all' && linkedTo(resource.data.landlordId));
      allow update, delete: if activeUser() && myRole() == 'landlord' && resource.data.landlordId == request.auth.uid;
    }


    match /pamphlets/{pamphletId} {
      allow create: if activeUser() && myRole() == 'landlord' &&
        request.resource.data.landlordId == request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 &&
        request.resource.data.type in ['rentNotice', 'eviction', 'appreciation', 'rules'] &&
        request.resource.data.copies is int && request.resource.data.copies >= 1 &&
        request.resource.data.copies <= 500;
      allow read, delete: if activeUser() && myRole() == 'landlord' &&
        resource.data.landlordId == request.auth.uid;
      allow update: if activeUser() && myRole() == 'landlord' &&
        resource.data.landlordId == request.auth.uid &&
        request.resource.data.landlordId == request.auth.uid &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPrinted', 'printedAt']) &&
        request.resource.data.isPrinted is bool;
    }

    match /meters/{id} {
      allow create: if activeUser() && myRole() == 'landlord' && request.resource.data.landlordId == request.auth.uid;
      allow read, update, delete: if activeUser() && myRole() == 'landlord' && resource.data.landlordId == request.auth.uid;
    }
    match /electricityAllocations/{id} {
      allow create: if activeUser() && myRole() == 'landlord' && request.resource.data.landlordId == request.auth.uid;
      allow read, update, delete: if activeUser() && myRole() == 'landlord' && resource.data.landlordId == request.auth.uid;
    }

    match /calendarEvents/{eventId} {
      allow create: if activeUser() && myRole() == 'landlord' &&
        request.resource.data.landlordId == request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.eventDate is timestamp &&
        request.resource.data.type in ['rentDue', 'inspection', 'meeting', 'loan', 'blackout', 'other'] &&
        request.resource.data.note is string &&
        request.resource.data.isRecurring is bool;
      allow read: if activeUser() && myRole() == 'landlord' &&
        resource.data.landlordId == request.auth.uid;
      allow update: if activeUser() && myRole() == 'landlord' &&
        resource.data.landlordId == request.auth.uid &&
        request.resource.data.landlordId == request.auth.uid &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['title', 'note', 'type', 'eventDate', 'isRecurring']
        );
      allow delete: if activeUser() && myRole() == 'landlord' &&
        resource.data.landlordId == request.auth.uid;
    }

    match /activityLogs/{id} {
      allow read: if activeUser() && myRole() == 'landlord' && resource.data.landlordId == request.auth.uid;
      allow create: if activeUser() && landlordFor(request.resource.data.landlordId) &&
        request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    match /plans/{recordId} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid;
    }
    // Tenant-submitted payments: tenant owns creation; linked landlord reviews.
    match /paymentSubmissions/{id} {
      allow create: if activeUser() && myRole() == 'tenant' &&
        request.resource.data.tenantId == request.auth.uid &&
        request.resource.data.landlordId == profile(request.auth.uid).landlordId &&
        request.resource.data.amount is number && request.resource.data.amount > 0 &&
        request.resource.data.method in ['MPESA', 'CASH', 'BANK', 'OTHER'] &&
        request.resource.data.status == 'pending';
      allow read: if activeUser() && (
        resource.data.tenantId == request.auth.uid ||
        (myRole() == 'landlord' && resource.data.landlordId == request.auth.uid)
      );
      allow update: if activeUser() && myRole() == 'landlord' &&
        resource.data.landlordId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['status', 'ledgerPaymentId', 'reviewedAt']
        ) &&
        request.resource.data.status in ['received', 'rejected', 'awaiting_caretaker'];
      allow delete: if false;
    }

    // M-Pesa transaction-code reservation must be atomically paired with its submission.
    match /mpesaTransactionCodes/{code} {
      allow create: if activeUser() && myRole() == 'tenant' &&
        code.matches('^[A-Z0-9]{8,16}$') &&
        request.resource.data.keys().hasOnly(['tenantId', 'landlordId', 'submissionId', 'createdAt']) &&
        request.resource.data.tenantId == request.auth.uid &&
        request.resource.data.landlordId == profile(request.auth.uid).landlordId &&
        request.resource.data.submissionId is string &&
        validMpesaClaim(code);
      allow read: if activeUser() && (
        resource.data.tenantId == request.auth.uid ||
        (myRole() == 'landlord' && resource.data.landlordId == request.auth.uid)
      );
      allow update, delete: if false;
    }

    // Calculator notes are private to the account that created them.
    match /savedCalculations/{calculationId} {
      allow create: if activeUser() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0;
      allow read, delete: if activeUser() &&
        resource.data.createdBy == request.auth.uid;
      allow update: if activeUser() &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid;
    }

    match /subscriptions/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }
  }
}